        <mxCell id="p2-build-text" parent="1" style="text;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;" value="Standalone mode (current):&#xa;  Mount source → analyze.py → SPDX&#xa;  Uses container&#39;s toolchains&#xa;&#xa;Sidecar mode (planned):&#xa;  CC= wrappers call YOUR gcc/clang&#xa;  SBOM reflects your production build" vertex="1">
