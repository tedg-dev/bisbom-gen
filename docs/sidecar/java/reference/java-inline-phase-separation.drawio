        <mxCell id="store" parent="1" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontStyle=1;align=center;" value="Durable artifact store&#xa;(S3 / Artifactory)&#xa;push BEFORE teardown&#xa;~1–2 KB + treedb" vertex="1">
          <mxGeometry height="107" width="154" x="540" y="152" as="geometry" />
        </mxCell>
        <mxCell id="p2box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eafaf1;strokeColor=#1e8449;strokeWidth=2;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#1e8449;" value="PHASE 2  —  separate host / Corona  (async, off the critical path)" vertex="1">
          <mxGeometry height="560" width="450" x="720" y="80" as="geometry" />
        </mxCell>
        <mxCell id="p2read" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" value="&lt;b&gt;Inputs (downloaded from the store)&lt;/b&gt;&#xa;• treedb&#xa;• maven_deps.json / gradle_deps.json&#xa;• phase1_manifest.json (verify gitoids)&#xa;&#xa;NO source tree · NO JARs · NO build tools&#xa;needed for hashing (Java is the exception —&#xa;phase2-binary-artifact-deps.md §5)." vertex="1">
          <mxGeometry height="180" width="390" x="750" y="120" as="geometry" />
