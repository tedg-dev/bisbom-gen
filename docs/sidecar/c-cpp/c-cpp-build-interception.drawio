        <mxCell id="meta-label" parent="1" style="text;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=3;verticalAlign=top;rounded=1" value="Shim captures per exec():&#xa;• tool name (gcc/ar/ld)&#xa;• input files + SHA-256 hashes&#xa;• output files + SHA-256 hashes" vertex="1">
          <mxGeometry height="55" width="128" x="56" y="446" as="geometry" />
        </mxCell>
        <mxCell id="rawlog" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=5;verticalAlign=top" value="bomsh_hook_raw_logfile (text)&#xa;&#xa;One record per execve():&#xa;pid | tool | input_files[] | output_files[]&#xa;     | input_hashes[] | output_hashes[]&#xa;&#xa;Example (gcc): main.c,util.h → main.o&#xa;Example (ar): a.o,b.o,c.o → libfoo.a&#xa;Example (ld): main.o,libfoo.a → binary" vertex="1">
          <mxGeometry height="120" width="220" x="40" y="618" as="geometry" />
        </mxCell>
        <mxCell id="bomsh-py" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;verticalAlign=top" value="bomsh_create_bom.py&#xa;(Python script)&#xa;&#xa;Parses raw logfile,&#xa;builds dependency graph" vertex="1">
          <mxGeometry height="90" width="150" x="311" y="633" as="geometry" />
        </mxCell>
        <mxCell id="treedb" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=5;verticalAlign=top" value="bomsh_omnibor_treedb&#xa;(JSON file)&#xa;&#xa;{ &quot;gitoid:sha256:abc123...&quot;:&#xa;    &quot;/build/src/main.c&quot;,&#xa;  &quot;gitoid:sha256:def456...&quot;:&#xa;    &quot;/build/obj/main.o&quot;, ... }" vertex="1">
          <mxGeometry height="110" width="150" x="515" y="538" as="geometry" />
        </mxCell>
        <mxCell id="adg" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=5;verticalAlign=top" value="ADG (.omnibor/ directory)&#xa;&#xa;One file per output artifact:&#xa;gitoid:sha256:&lt;binary_hash&gt;&#xa;├─ blob &lt;input1_hash&gt;&#xa;├─ blob &lt;input2_hash&gt;&#xa;└─ blob &lt;inputN_hash&gt;&#xa;&#xa;Maps: output → all inputs" vertex="1">
          <mxGeometry height="110" width="150" x="515" y="668" as="geometry" />
        </mxCell>
        <mxCell id="c2" edge="1" parent="1" source="rawlog" target="bomsh-py">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" edge="1" parent="1" source="bomsh-py" target="treedb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" edge="1" parent="1" source="bomsh-py" target="adg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2-note" parent="1" style="shape=note;size=14;fillColor=#e0e0e0;strokeColor=#9e9e9e;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;whiteSpace=wrap" value="SECTION 2 DATA FLOW :&#xa;1. Build runs with LD_PRELOAD=libbomsh.so (shim in every child)&#xa;2. Shim interposes libc exec() before each tool runs&#xa;3. Shim inspects: which tool? what inputs? what outputs?&#xa;4. Computes SHA-256 hash (gitoid) of each file&#xa;5. Appends record to raw logfile, then calls the real exec()&#xa;6. After build: bomsh_create_bom.py parses logfile:&#xa;   • bomsh_omnibor_treedb: JSON mapping gitoid → path&#xa;   • ADG: per-artifact file listing input gitoids&#xa;&#xa;gitoid format: &quot;gitoid:sha256:&lt;64-hex-chars&gt;&quot;&#xa;ADG = Artifact Dependency Graph (OmniBOR standard)" vertex="1">
          <mxGeometry height="160" width="280" x="715" y="548" as="geometry" />
        </mxCell>
        <mxCell id="div2" parent="1" style="line;strokeWidth=3;strokeColor=#1D1D1D;dashed=1" value="" vertex="1">
          <mxGeometry height="10" width="980" x="40" y="798" as="geometry" />
        </mxCell>
        <mxCell id="s3-title" parent="1" style="text;html=1;fontSize=16;fontStyle=1" value="Section 3: bisbom-gen — SPDX Generation from ADG" vertex="1">
          <mxGeometry height="25" width="500" x="40" y="818" as="geometry" />
        </mxCell>
        <mxCell id="adg-in" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1" value="ADG&#xa;(.omnibor/)" vertex="1">
