        </mxCell>
        <mxCell id="buildst" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Build&lt;/b&gt;&#xa;mvn package /&#xa;gradle build&#xa;(UNCHANGED)" vertex="1">
          <mxGeometry height="70" width="170" x="240" y="136" as="geometry" />
        </mxCell>
        <mxCell id="capst" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;+ Build-based SBOM (Phase 1)&lt;/b&gt;&#xa;dep:tree + treedb&#xa;+ manifest&#xa;→ upload to Corona S3&#xa;(seconds)" vertex="1">
