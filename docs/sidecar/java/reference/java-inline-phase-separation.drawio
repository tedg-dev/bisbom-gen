        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;" value="Phase 1 / Phase 2 separation across the EPHEMERAL build boundary" vertex="1">
          <mxGeometry height="30" width="1020" x="90" y="12" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=12;fontStyle=2;align=center;fontColor=#666666;" value="Everything Phase 2 needs is captured inline and pushed to durable storage BEFORE the workspace is destroyed." vertex="1">
