<mxfile host="Electron" agent="Cascade AI">
  <diagram id="java-inline-cvp" name="Current vs Proposed">
    <mxGraphModel dx="1592" dy="1089" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;" value="Java Phase 1 — Current (post-build rescan) vs Proposed (inline hashing)" vertex="1">
          <mxGeometry height="30" width="1000" x="90" y="12" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=12;fontStyle=2;align=center;fontColor=#666666;" value="Same build command, same output SBOM. Only WHEN the artifacts are hashed changes." vertex="1">
          <mxGeometry height="20" width="1000" x="90" y="42" as="geometry" />
        </mxCell>
        <mxCell id="curPanel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0392b;strokeWidth=2;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#c0392b;" value="CURRENT  —  hashing deferred to a post-build workspace rescan" vertex="1">
          <mxGeometry height="560" width="520" x="70" y="80" as="geometry" />
        </mxCell>
        <mxCell id="curBuild" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" value="&lt;b&gt;Build step (developer critical path)&lt;/b&gt;&#xa;mvn package  —  uninstrumented&#xa;instrument_command() is a NO-OP&#xa;(interception.py:349-355 / 465-471)" vertex="1">
          <mxGeometry height="80" width="440" x="110" y="120" as="geometry" />
        </mxCell>
        <mxCell id="curArrow" edge="1" parent="1" source="curBuild" style="endArrow=classic;strokeColor=#c0392b;strokeWidth=2;" target="curAdg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="curArrowLbl" connectable="0" parent="1" style="edgeLabel;html=1;fontSize=10;fontColor=#c0392b;fontStyle=1;" value="build completes → THEN scan" vertex="1">
          <mxGeometry height="16" width="180" x="337" y="205" as="geometry" />
        </mxCell>
        <mxCell id="curAdg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" value="&lt;b&gt;generate_adg(): bomsh_create_bom_java.py&lt;/b&gt;   (O(N) rescan)&#xa;&#xa;• find *.class / *.jar across whole workspace&#xa;• jar -xf / unzip every JAR&#xa;• git hash-object (SHA-1) on EVERY .class + .jar&#xa;• parse SourceFile attribute on EVERY .class&#xa;&#xa;Re-reads every artifact the build just wrote." vertex="1">
          <mxGeometry height="170" width="440" x="110" y="240" as="geometry" />
        </mxCell>
        <mxCell id="curCost" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" value="&lt;b&gt;Measured add-on cost (EC2, warm caches)&lt;/b&gt;&#xa;&#xa;spring-boot:        adg 79.6 s  on 21.7 s build  = +362%&#xa;dependency-check:  adg 22.9 s  on 22.2 s build  = +102%&#xa;bc-java 18.5 s · checkstyle 6.3 s · log4j2 4.8 s&#xa;&#xa;Cost scales with artifact count N." vertex="1">
          <mxGeometry height="180" width="440" x="110" y="435" as="geometry" />
        </mxCell>
        <mxCell id="propPanel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eafaf1;strokeColor=#1e8449;strokeWidth=2;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#1e8449;" value="PROPOSED  —  hash inline during interception (the build-interception rule)" vertex="1">
          <mxGeometry height="560" width="520" x="620" y="80" as="geometry" />
        </mxCell>
        <mxCell id="propBuild" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" value="&lt;b&gt;Build step (developer critical path)&lt;/b&gt;&#xa;mvn package  —  UNCHANGED command&#xa;+ LD_PRELOAD shim (env, set in CI/CD YAML)&#xa;&#xa;At each .class/.jar close(): compute SHA-1 +&#xa;SHA-256 gitoid + parse SourceFile from the&#xa;bytes already in the page cache.&#xa;Cost amortized into the build&#39;s own file I/O." vertex="1">
          <mxGeometry height="150" width="440" x="660" y="120" as="geometry" />
        </mxCell>
        <mxCell id="propArrow" edge="1" parent="1" source="propBuild" style="endArrow=classic;strokeColor=#1e8449;strokeWidth=2;" target="propAdg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="propArrowLbl" connectable="0" parent="1" style="edgeLabel;html=1;fontSize=10;fontColor=#1e8449;fontStyle=1;" value="capture.jsonl already written" vertex="1">
          <mxGeometry height="16" width="180" x="884" y="273" as="geometry" />
        </mxCell>
        <mxCell id="propAdg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" value="&lt;b&gt;generate_adg(): assemble treedb from capture.jsonl&lt;/b&gt;&#xa;&#xa;• NO find — paths already recorded&#xa;• NO unzip — JAR entries read at jar close()&#xa;• NO re-hash — SHA-1/SHA-256 already computed&#xa;• NO re-parse — SourceFile already captured&#xa;&#xa;Pure in-memory assembly into the bomsh schema." vertex="1">
          <mxGeometry height="150" width="440" x="660" y="310" as="geometry" />
        </mxCell>
        <mxCell id="propCost" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" value="&lt;b&gt;Target cost&lt;/b&gt;&#xa;&#xa;Build-stage in-band overhead: +1–3%&#xa;(matches C/C++/Go/Rust inline interception)&#xa;&#xa;Post-build assembly: seconds, O(events),&#xa;no artifact re-read." vertex="1">
          <mxGeometry height="135" width="440" x="660" y="480" as="geometry" />
        </mxCell>
        <mxCell id="insight" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" value="&lt;b&gt;Key insight:&lt;/b&gt; every input the rescan recomputes (SHA-1, SHA-256, SourceFile, JAR→class membership) is available from the artifact bytes at the moment the build writes them. Inline capture removes the second full pass." vertex="1">
          <mxGeometry height="70" width="1070" x="70" y="655" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
