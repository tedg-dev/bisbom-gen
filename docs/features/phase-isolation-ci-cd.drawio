          <mxGeometry height="50" width="100" x="195" y="285" as="geometry" />
        </mxCell>
        <mxCell id="p1_jars" parent="1" style="shape=hexagon;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;size=8;" value="target/*.jar&#xa;(build output)" vertex="1">
          <mxGeometry height="45" width="100" x="310" y="288" as="geometry" />
