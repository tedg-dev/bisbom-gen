        </mxCell>
        <mxCell id="p2-you-text" parent="1" style="text;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;" value="• Any host with Docker (Linux, macOS, Windows)&#xa;• x86_64 architecture (ARM64 requires bomtrace3 porting)&#xa;• SYS_PTRACE capability in container runtime&#xa;• Your source code repository" vertex="1">
          <mxGeometry height="80" width="330" x="180" y="927" as="geometry" />
        </mxCell>
