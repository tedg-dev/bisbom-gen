        <mxCell id="a10" edge="1" parent="1" source="cargo1" style="dashed=1;strokeColor=#666666;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=1;exitY=0.338;exitDx=0;exitDy=0;exitPerimeter=0;" target="link1">
