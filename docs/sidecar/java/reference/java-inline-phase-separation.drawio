        </mxCell>
        <mxCell id="p1box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#1565c0;strokeWidth=2;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=8;fontColor=#1565c0;" value="PHASE 1  —  ephemeral CI/CD build host  (destroyed after the job)" vertex="1">
          <mxGeometry height="560" width="470" x="43" y="80" as="geometry" />
        </mxCell>
        <mxCell id="p1build" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" value="&lt;b&gt;Build (unchanged)&lt;/b&gt;&#xa;mvn package + LD_PRELOAD shim&#xa;hashes .class/.jar inline at close()" vertex="1">
          <mxGeometry height="70" width="400" x="78" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p1cap" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;fontSize=11;align=center;verticalAlign=middle;" value="capture.jsonl  (inline events)" vertex="1">
