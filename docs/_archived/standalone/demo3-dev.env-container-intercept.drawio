        <mxCell id="Oh_HtpFAZzUBUrxv-mm9-4" parent="1" style="rounded=1;fillColor=none;strokeColor=#9673a6;strokeWidth=3;fontSize=14;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" value="Docker Container (omnibor-env) — self-contained" vertex="1">
          <mxGeometry height="800" width="640" x="80" y="100" as="geometry" />
        </mxCell>
        <mxCell id="Oh_HtpFAZzUBUrxv-mm9-5" parent="1" style="text;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;" value="Container provides BOTH toolchains AND interception tools.&#xa;Builds use the container&#39;s gcc/clang, not your native versions." vertex="1">
