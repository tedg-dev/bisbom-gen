        </mxCell>
        <mxCell id="p1_step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" value="4. Write phase1_manifest.json&#xa;   (GitOID SHA-256 integrity)" vertex="1">
          <mxGeometry height="35" width="210" x="365" y="220" as="geometry" />
