<mxfile host="app.diagrams.net" agent="Cascade" pages="1">
  <diagram id="sbom-pipeline-overview" name="SBOM Pipeline Overview">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;fontColor=#333333;" value="Tree-Based SBOM Production — Phase 1 &amp; Phase 2 Overview" vertex="1">
          <mxGeometry x="280" y="20" width="560" height="40" as="geometry" />
        </mxCell>

        <!-- Phase 1 label -->
        <mxCell id="phase1_label" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontStyle=3;fontColor=#82b366;" value="Phase 1 — Build Site" vertex="1">
          <mxGeometry x="100" y="80" width="310" height="30" as="geometry" />
        </mxCell>

        <!-- Phase 2 label -->
        <mxCell id="phase2_label" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontStyle=3;fontColor=#6c8ebf;" value="Phase 2 — Cloud Processing" vertex="1">
          <mxGeometry x="700" y="80" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- Box 1: Build Pipeline GitHub/Jenkins -->
        <mxCell id="build_pipeline" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;spacingTop=5;spacingBottom=5;shadow=1;" value="Build Pipeline&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal;'&gt;GitHub Actions / Jenkins&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555;'&gt;• Compile source code&lt;br&gt;• Run omnibor-sidecar (Phase 1)&lt;br&gt;• Produce build artifacts,&lt;br&gt;  dependency tree, bomsh treedb&lt;br&gt;• Generate phase1_manifest.json&lt;/font&gt;" vertex="1">
          <mxGeometry x="50" y="120" width="240" height="180" as="geometry" />
        </mxCell>

        <!-- Box 2: OIDC Federated Connectivity -->
        <mxCell id="oidc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;spacingTop=5;spacingBottom=5;shadow=1;" value="OIDC Federated&lt;br&gt;Connectivity&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555;'&gt;• No long-lived AWS keys&lt;br&gt;• AssumeRoleWithWebIdentity&lt;br&gt;• GitHub / Jenkins OIDC tokens&lt;br&gt;• Scoped IAM role&lt;/font&gt;" vertex="1">
          <mxGeometry x="50" y="360" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- Box 3: S3 -->
        <mxCell id="s3" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;shadow=1;" value="S3&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555;'&gt;omnibor-spdx-artifacts&lt;br&gt;&lt;br&gt;• Phase 1 outputs&lt;br&gt;• Build artifacts&lt;br&gt;• SPDX documents&lt;br&gt;• Hierarchical SBOM&lt;/font&gt;" vertex="1">
          <mxGeometry x="430" y="140" width="200" height="160" as="geometry" />
        </mxCell>

        <!-- Box 4: Operator -->
        <mxCell id="operator" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;spacingTop=5;spacingBottom=5;shadow=1;" value="Operator&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal;'&gt;Go Service (ECS / Docker)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555;'&gt;• Poll SQS for Phase 1 events&lt;br&gt;• Download Phase 1 from S3&lt;br&gt;• Launch Phase 2 container&lt;br&gt;• Upload results back to S3&lt;br&gt;• Index artifacts in DynamoDB&lt;/font&gt;" vertex="1">
          <mxGeometry x="730" y="120" width="240" height="180" as="geometry" />
        </mxCell>

        <!-- Box 5: SPDX Generation -->
        <mxCell id="spdx_gen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;spacingTop=5;spacingBottom=5;shadow=1;" value="SPDX Generation&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal;'&gt;omnibor-sidecar (Phase 2)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal;color:#555555;'&gt;• Parse bomsh treedb&lt;br&gt;• Resolve dependency tree&lt;br&gt;• Emit SPDX 2.3 JSON&lt;br&gt;• Flat SBOM per artifact&lt;/font&gt;" vertex="1">
          <mxGeometry x="730" y="370" width="240" height="160" as="geometry" />
        </mxCell>

