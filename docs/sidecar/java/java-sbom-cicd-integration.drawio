        <mxCell id="bottomnote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;strokeWidth=2;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" value="&lt;b&gt;What changes:&lt;/b&gt; Phase 1 metadata capture is added to your existing CI/CD build step, after your build completes. No new pipeline steps. Your build scripts (pom.xml / build.gradle) and build invocations (mvn / gradle) are not modified. No privileged runners." vertex="1">
