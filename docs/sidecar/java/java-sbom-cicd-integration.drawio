        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666666;" value="Phase 1 metadata capture is added to your existing CI/CD build step. It runs in seconds, after your build completes. SBOM generation happens in Corona — asynchronous, never blocks Test or Deploy." vertex="1">
