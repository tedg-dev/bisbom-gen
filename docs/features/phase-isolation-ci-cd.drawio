        <mxCell id="p1_step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=9;" value="3. analyze.py --phase build&#xa;   bomsh_create_bom_java.py&#xa;   mvn dependency:tree" vertex="1">
