          <mxGeometry height="45" width="80" x="40" y="840" as="geometry" />
        </mxCell>
        <mxCell id="tree-in" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9" value="bomsh_omnibor&#xa;_treedb" vertex="1">
          <mxGeometry height="45" width="80" x="40" y="900" as="geometry" />
        </mxCell>
