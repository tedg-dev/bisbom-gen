        <mxCell id="deployst" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;verticalAlign=middle;" value="Deploy" vertex="1">
          <mxGeometry height="70" width="160" x="880" y="136" as="geometry" />
