        <!-- Phase 2 Container -->
        <mxCell id="p2_ctr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#27ae60;strokeWidth=2;fontSize=11;fontStyle=1;verticalAlign=top;" value="Phase 2 Container (FRESH)&lt;br&gt;&lt;font style=&quot;font-weight:normal;font-size:9px;color:#1e8449&quot;&gt;ghcr.io/tedg-dev/omnibor-sidecar (different instance)&lt;/font&gt;" vertex="1">
