          </mxGeometry>
        </mxCell>
        <mxCell id="xk5" edge="1" parent="1" source="k5" style="strokeWidth=2;strokeColor=#8A8A8A;dashed=1;dashPattern=4 4;entryX=0.967;entryY=0.846;entryDx=0;entryDy=0;entryPerimeter=0;" target="t4" value="waitpid() returns">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="530" y="915" />
              <mxPoint x="500" y="910" />
              <mxPoint x="500" y="510" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="tracee-box" parent="1" style="rounded=0;fillColor=none;strokeColor=#6c8ebf;strokeWidth=3" value="" vertex="1">
          <mxGeometry height="920" width="440" x="830" y="100" as="geometry" />
        </mxCell>
        <mxCell id="tracee-lbl" parent="1" style="text;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;rounded=1" value="TRACEE PROCESSES: Build Tools (children)" vertex="1">
          <mxGeometry height="28" width="438" x="831" y="100" as="geometry" />
        </mxCell>
        <mxCell id="c-make" parent="1" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=1" value="make -j$(nproc)&#xa;Reads Makefile, spawns tools via fork()+execve()" vertex="1">
          <mxGeometry height="45" width="300" x="900" y="170" as="geometry" />
        </mxCell>
        <mxCell id="c-gcc" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontStyle=1" value="execve(gcc -c main.c -o main.o)&#xa;Kernel pauses here, tracer inspects&#xa;After PTRACE_CONT: compiles, exit(0)" vertex="1">
          <mxGeometry height="55" width="300" x="900" y="290" as="geometry" />
        </mxCell>
        <mxCell id="c-ar" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontStyle=1" value="execve(ar rcs libcurl.a *.o)&#xa;Kernel pauses, tracer inspects, CONT, exit(0)" vertex="1">
          <mxGeometry height="45" width="300" x="900" y="400" as="geometry" />
        </mxCell>
        <mxCell id="c-ld" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontStyle=1" value="execve(ld -o curl *.o *.a -lssl)&#xa;Kernel pauses, tracer inspects, CONT, exit(0)" vertex="1">
          <mxGeometry height="45" width="300" x="900" y="500" as="geometry" />
        </mxCell>
        <mxCell id="c-dots" parent="1" style="text;fontSize=10;fontStyle=2;align=center;fontColor=#888" value="... repeated for every tool invocation ..." vertex="1">
          <mxGeometry height="25" width="300" x="900" y="575" as="geometry" />
        </mxCell>
        <mxCell id="rawlog-p1" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=8;verticalAlign=top" value="bomsh_hook_raw_logfile (output)&#xa;&#xa;Record 1 (gcc):&#xa;outfile: 7a8b.. path: main.o&#xa;infile: 1234.. path: main.c&#xa;infile: abcd.. path: curl.h&#xa;infile: fedc.. path: stdio.h&#xa;&#xa;Record 2 (ar):&#xa;outfile: 2223.. path: libcurl.a&#xa;infile: aaa1.. path: x509.o&#xa;infile: bbb2.. path: ssl.o&#xa;&#xa;Record 3 (ld):&#xa;outfile: fff0.. path: curl&#xa;infile: 7a8b.. path: main.o&#xa;infile: 2223.. path: libcurl.a&#xa;dynlib: ccc5.. path: libssl.so" vertex="1">
          <mxGeometry height="270" width="230" x="900" y="630" as="geometry" />
        </mxCell>
        <mxCell id="ca1" edge="1" parent="1" source="c-make" style="dashed=1;strokeColor=#666" target="c-gcc" value="fork+exec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ca2" edge="1" parent="1" source="c-make" style="dashed=1;strokeColor=#666" target="c-ar">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ca3" edge="1" parent="1" source="c-make" style="dashed=1;strokeColor=#666" target="c-ld">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xc1" edge="1" parent="1" source="k2" style="strokeWidth=2;strokeColor=#c62828;dashed=1;dashPattern=4 4" target="c-gcc" value="SIGTRAP">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xc2" edge="1" parent="1" source="k4" style="strokeWidth=2;strokeColor=#c62828;dashed=1;dashPattern=4 4" target="c-ld" value="resume">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="shape=note;size=14;fillColor=#e0e0e0;strokeColor=#9e9e9e;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;whiteSpace=wrap" value="KEY INSIGHT: Zero-instrumentation tracing&#xa;&#xa;bomtrace3 does NOT modify gcc, ar, or ld source code.&#xa;It uses the kernel ptrace() API to passively observe syscalls.&#xa;Build tools run their original, unmodified code.&#xa;&#xa;The ONLY modification is optional injection of -MD/-MF&#xa;flags into gcc argv (via PTRACE_POKEDATA) to force&#xa;dependency file generation. Does not affect output.&#xa;&#xa;Requirement: docker --cap-add=SYS_PTRACE&#xa;ptrace() is disabled by default in Docker." vertex="1">
          <mxGeometry height="175" width="310" x="1300" y="120" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="shape=note;size=14;fillColor=#e0e0e0;strokeColor=#9e9e9e;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;whiteSpace=wrap" value="PERFORMANCE:&#xa;&#xa;Each execve() interception = 2 context switches:&#xa;1. Tracee → Kernel → Tracer (pre-exec)&#xa;2. Tracer → Kernel → Tracee (PTRACE_CONT)&#xa;Plus one more pair at exit.&#xa;&#xa;For 1000 gcc invocations:&#xa;~4000 context switches + ~1000 file hashing ops.&#xa;Parallel -j builds amortize this overhead." vertex="1">
          <mxGeometry height="155" width="310" x="1300" y="320" as="geometry" />
        </mxCell>
        <mxCell id="p1-leg" parent="1" style="rounded=0;fillColor=none;strokeColor=#999;dashed=1" value="" vertex="1">
          <mxGeometry height="40" width="600" x="40" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="p1lt" parent="1" style="text;fontSize=11;fontStyle=1;align=left" value="Legend:" vertex="1">
          <mxGeometry height="25" width="50" x="50" y="1048" as="geometry" />
        </mxCell>
        <mxCell id="p1l1" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656" value="" vertex="1">
          <mxGeometry height="14" width="14" x="110" y="1052" as="geometry" />
        </mxCell>
        <mxCell id="p1l1t" parent="1" style="text;fontSize=9;align=left" value="bomsh code" vertex="1">
          <mxGeometry height="18" width="65" x="128" y="1050" as="geometry" />
