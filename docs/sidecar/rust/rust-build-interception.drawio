        <mxCell id="meta-label" parent="1" style="text;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=3;verticalAlign=top;rounded=1" value="bomtrace2 captures per execve():&#xa;• tool name (rustc)&#xa;• input files + SHA-256 hashes&#xa;• output files + SHA-256 hashes" vertex="1">
          <mxGeometry height="55" width="145" x="47.5" y="447" as="geometry" />
        </mxCell>
        <mxCell id="rawlog" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=5;verticalAlign=top" value="bomsh_hook_raw_logfile (text)&#xa;&#xa;One record per execve():&#xa;pid | tool | input_files[] | output_files[]&#xa;     | input_hashes[] | output_hashes[]&#xa;&#xa;Example (rustc): lib.rs,mod.rs → libfoo.rlib&#xa;Example (link): *.rlib → binary" vertex="1">
          <mxGeometry height="105" width="220" x="40" y="608" as="geometry" />
        </mxCell>
        <mxCell id="bomsh-py" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;verticalAlign=top" value="bomsh_create_bom.py&#xa;(Python script)&#xa;&#xa;Parses raw logfile,&#xa;builds dependency graph" vertex="1">
          <mxGeometry height="90" width="150" x="311" y="618" as="geometry" />
        </mxCell>
        <mxCell id="treedb" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=5;verticalAlign=top" value="bomsh_omnibor_treedb&#xa;(JSON file)&#xa;&#xa;{ &quot;gitoid:sha256:abc123...&quot;:&#xa;    &quot;~/.cargo/.../bitvec-1.0.1/src/lib.rs&quot;,&#xa;  &quot;gitoid:sha256:def456...&quot;:&#xa;    &quot;target/release/deps/libbitvec.rlib&quot;, ... }" vertex="1">
          <mxGeometry height="100" width="200" x="515" y="528" as="geometry" />
        </mxCell>
        <mxCell id="adg" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=5;verticalAlign=top" value="ADG (.omnibor/ directory)&#xa;&#xa;One file per output artifact:&#xa;gitoid:sha256:&lt;binary_hash&gt;&#xa;├─ blob &lt;crate1.rlib_hash&gt;&#xa;├─ blob &lt;crate2.rlib_hash&gt;&#xa;└─ blob &lt;crateN.rlib_hash&gt;&#xa;&#xa;Maps: binary → all .rlib inputs" vertex="1">
          <mxGeometry height="110" width="175" x="515" y="648" as="geometry" />
        </mxCell>
        <mxCell id="c2" edge="1" parent="1" source="rawlog" target="bomsh-py">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" edge="1" parent="1" source="bomsh-py" target="treedb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" edge="1" parent="1" source="bomsh-py" target="adg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2-note" parent="1" style="shape=note;size=14;fillColor=#e0e0e0;strokeColor=#9e9e9e;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;whiteSpace=wrap" value="SECTION 2 DATA FLOW (Rust-specific):&#xa;1. bomtrace2 spawns cargo build as child, attaches via ptrace()&#xa;2. Kernel pauses child at every execve() syscall&#xa;3. bomtrace2 inspects: which tool? what inputs? what outputs?&#xa;4. Computes SHA-256 hash (gitoid) of each file&#xa;5. Writes record to raw logfile, resumes child&#xa;6. After build: bomsh_create_bom.py parses logfile:&#xa;   • bomsh_omnibor_treedb: JSON mapping gitoid → path&#xa;   • ADG: per-artifact file listing input gitoids&#xa;&#xa;Key difference from C/C++:&#xa;• C/C++ uses bomtrace3, Rust uses bomtrace2&#xa;• Both use ptrace() to intercept execve()&#xa;• Rust crate sources in ~/.cargo/registry/src/" vertex="1">
          <mxGeometry height="192" width="250" x="750" y="508" as="geometry" />
        </mxCell>
        <mxCell id="div2" parent="1" style="line;strokeWidth=3;strokeColor=#1D1D1D;dashed=1" value="" vertex="1">
          <mxGeometry height="10" width="980" x="40" y="778" as="geometry" />
        </mxCell>
