        <mxCell id="oGit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10;align=center;verticalAlign=middle;" value="artifact identity: SHA-256 gitoid + raw SHA-256 per JAR" vertex="1">
