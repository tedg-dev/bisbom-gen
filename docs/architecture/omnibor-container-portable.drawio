        </mxCell>
        <mxCell id="p2-container-text" parent="1" style="text;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;" value="• OmniBOR/bomsh interception tools (core value)&#xa;• CC=/RUSTC_WRAPPER compiler wrappers (planned)&#xa;• SPDX generation + analysis pipeline&#xa;• Default build toolchains (standalone mode only)&#xa;• Windsurf rules + workflows (if using IDE)" vertex="1">
          <mxGeometry height="80" width="330" x="575" y="924" as="geometry" />
        </mxCell>
        <mxCell id="p2-container-label" parent="1" style="text;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#9673a6;spacingLeft=10;" value="OmniBOR Analysis Container (Docker)" vertex="1">
          <mxGeometry height="25" width="400" x="125" y="73" as="geometry" />
        </mxCell>
        <mxCell id="p2-container-tag" parent="1" style="text;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#9673a6;spacingLeft=10;" value="docker pull / docker compose build" vertex="1">
          <mxGeometry height="15" width="300" x="125" y="96" as="geometry" />
        </mxCell>
        <mxCell id="p2-portable-badge" parent="1" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" value="PORTABLE — deploy on any Docker host (x86_64)" vertex="1">
          <mxGeometry height="28" width="340" x="610" y="84" as="geometry" />
        </mxCell>
        <mxCell id="p2-bomsh" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" value="OmniBOR Interception Tools" vertex="1">
          <mxGeometry height="140" width="450" x="100" y="125" as="geometry" />
        </mxCell>
        <mxCell id="p2-bomsh-text" parent="1" style="text;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;" value="OmniBOR Interception Tools (core value — both modes)&#xa;  bomtrace3 — ptrace-based interceptor (C/C++)&#xa;  bomtrace2 — hook-based interceptor (Go, Rust)&#xa;  CC=/CXX= wrappers — planned sidecar (C/C++)&#xa;  RUSTC_WRAPPER — planned sidecar (Rust)&#xa;  strace openat — Java interception (sidecar-ready)&#xa;&#xa;bomsh_create_bom.py — builds ADG from raw logfile&#xa;bomsh_hook2.py — Go/Rust interception hooks" vertex="1">
          <mxGeometry height="110" width="440" x="105" y="143" as="geometry" />
        </mxCell>
        <mxCell id="p2-toolchains" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" value="Default Build Toolchains (standalone mode — overridable)" vertex="1">
          <mxGeometry height="140" width="450" x="570" y="125" as="geometry" />
        </mxCell>
        <mxCell id="p2-toolchains-text" parent="1" style="text;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;" value="CURRENT (standalone mode): container provides all toolchains&#xa;  C/C++: gcc 11, g++ 11, clang 14, make, cmake, autotools&#xa;  Go: Go 1.26.0, Rust: stable via rustup&#xa;  Java: OpenJDK 17+21, Maven 3.6+3.9&#xa;&#xa;SIDECAR MODE (planned): CC= compiler wrappers,&#xa;  RUSTC_WRAPPER, strace — call through to YOUR native toolchain. &#xa;Container provides interception tools only. SBOM reflects your production build." vertex="1">
          <mxGeometry height="110" width="440" x="575" y="143" as="geometry" />
        </mxCell>
        <mxCell id="p2-pipeline" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" value="Analysis Pipeline (omnibor-analysis)" vertex="1">
          <mxGeometry height="140" width="450" x="100" y="280" as="geometry" />
        </mxCell>
        <mxCell id="p2-pipeline-text" parent="1" style="text;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;" value="analyze.py — main orchestrator&#xa;  1. Clone repo (git, specific release tag)&#xa;  2. Syft baseline SBOM (manifest-based)&#xa;  3. Instrumented build (bomtrace3 wraps make)&#xa;  4. ADG generation (bomsh_create_bom.py)&#xa;  5. SPDX generation (spdx_from_adg.py)&#xa;  6. Metadata collection&#xa;  7. SPDX validation (spdx-tools)&#xa;  8. Build documentation" vertex="1">
          <mxGeometry height="110" width="440" x="105" y="296" as="geometry" />
        </mxCell>
        <mxCell id="p2-sbom" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" value="SBOM Generation + Output" vertex="1">
          <mxGeometry height="140" width="450" x="570" y="280" as="geometry" />
        </mxCell>
        <mxCell id="p2-sbom-text" parent="1" style="text;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;" value="SPDX 2.3 JSON — standard SBOM format&#xa;  Packages: every binary + vendored dependency&#xa;  Files: every source file with gitoid checksum&#xa;  Relationships: STATIC_LINK, DEPENDS_ON,&#xa;    GENERATED_FROM, BUILD_TOOL_OF&#xa;&#xa;OmniBOR ADG — gitoid-based artifact dependency graph&#xa;Treedb JSON — gitoid → filepath mapping&#xa;D3.js HTML — interactive dependency visualization" vertex="1">
          <mxGeometry height="110" width="440" x="575" y="296" as="geometry" />
        </mxCell>
        <mxCell id="p2-reqs" parent="1" style="rounded=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" value="Requirements: Docker host (x86_64) · SYS_PTRACE + seccomp:unconfined · Volume mounts for repos/ output/ app/ docs/" vertex="1">
          <mxGeometry height="28" width="920" x="100" y="435" as="geometry" />
        </mxCell>
        <mxCell id="p2-config" parent="1" style="rounded=1;fillColor=#d4edda;strokeColor=#5cb85c;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=3;" value="config.yaml — repo definitions" vertex="1">
          <mxGeometry height="125" width="450" x="100" y="475" as="geometry" />
        </mxCell>
        <mxCell id="p2-config-text" parent="1" style="text;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;fontFamily=Courier New;" value="Each target repo defined with:&#xa;  url: GitHub clone URL&#xa;  branch: stable release tag (e.g., curl-8_19_0)&#xa;  language: c-cpp | go | rust | java&#xa;  build_steps: [configure, make]  (last step wrapped by bomtrace3)&#xa;  output_binaries: [curl, libcurl.so]&#xa;  apt_deps: [libssl-dev, zlib1g-dev]" vertex="1">
          <mxGeometry height="75" width="440" x="105" y="496" as="geometry" />
        </mxCell>
        <mxCell id="p2-windsurf" parent="1" style="rounded=1;fillColor=#d4edda;strokeColor=#5cb85c;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=3;" value=".windsurf/ integration" vertex="1">
          <mxGeometry height="125" width="450" x="570" y="475" as="geometry" />
        </mxCell>
        <mxCell id="p2-windsurf-text" parent="1" style="text;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;fontFamily=Courier New;" value="Git-tracked rules + workflows clone with the repo:&#xa;  rules/ → Cascade AI auto-loads project conventions&#xa;  workflows/ → slash commands for common tasks&#xa;&#xa;New team members: clone + open in Windsurf →&#xa;  Cascade knows the project, tooling, and conventions&#xa;  Run /first-time-setup → environment ready in minutes" vertex="1">
          <mxGeometry height="75" width="440" x="575" y="496" as="geometry" />
        </mxCell>
