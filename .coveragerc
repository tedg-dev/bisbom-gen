[run]
# Only apply_qemu_fallback.py is excluded: it performs large, brittle
# string-surgery to emit C source into bomsh_hook.c/strace.c, and is
# validated solely by the Docker build under QEMU — testing it as Python
# would mean huge golden-string assertions with near-zero defect value.
# All other modules (incl. docker/patches and the metadata/lib collectors)
# are testable and are covered.
omit =
    app/apply_qemu_fallback.py
    docker/patches/apply_qemu_fallback.py

[report]
exclude_lines =
    if __name__ == .__main__.
