        <mxCell id="Oh_HtpFAZzUBUrxv-mm9-2" parent="1" style="text;fontSize=13;fontStyle=2;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" value="bomtrace3 intercepts every execve() via ptrace — self-contained container with its own toolchains" vertex="1">
          <mxGeometry height="20" width="700" x="350" y="45" as="geometry" />
        </mxCell>
        <mxCell id="Oh_HtpFAZzUBUrxv-mm9-3" parent="1" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=3;dashed=1;dashPattern=8 4;opacity=60;" value="Docker Host (EC2 instance, CI server, or local machine)" vertex="1">
