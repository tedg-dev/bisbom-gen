        <mxCell id="rgP4XJpEU2pRbP7EMXJJ-1" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center" value="OmniBOR Analysis: C/C++ Build Interception and SPDX Generation" vertex="1">
