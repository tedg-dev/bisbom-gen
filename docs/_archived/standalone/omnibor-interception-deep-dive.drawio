        </mxCell>
        <mxCell id="kernel-box" parent="1" style="rounded=0;fillColor=none;strokeColor=#c62828;strokeWidth=3" value="" vertex="1">
          <mxGeometry height="920" width="250" x="530" y="100" as="geometry" />
        </mxCell>
        <mxCell id="kernel-lbl" parent="1" style="text;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=13;fontStyle=1;align=center;rounded=1" value="LINUX KERNEL (ptrace subsystem)" vertex="1">
          <mxGeometry height="28" width="248" x="531" y="100" as="geometry" />
        </mxCell>
        <mxCell id="k1" parent="1" style="rounded=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=9;fontStyle=1" value="ptrace(PTRACE_TRACEME)&#xa;Child requests tracing by parent" vertex="1">
          <mxGeometry height="40" width="210" x="550" y="280" as="geometry" />
        </mxCell>
        <mxCell id="k2" parent="1" style="rounded=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=9;fontStyle=1" value="execve() syscall intercepted&#xa;&#xa;Kernel pauses tracee,&#xa;delivers SIGTRAP to tracer&#xa;via waitpid()&#xa;Tracee is FROZEN" vertex="1">
          <mxGeometry height="90" width="210" x="550" y="440" as="geometry" />
        </mxCell>
        <mxCell id="k3" parent="1" style="rounded=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=9;fontStyle=1" value="PTRACE_PEEKDATA / POKEDATA&#xa;&#xa;PEEK: tracer reads tracee memory&#xa;(copies argv, path strings)&#xa;&#xa;POKE: tracer writes tracee memory&#xa;(injects -MD flags into gcc argv)" vertex="1">
          <mxGeometry height="110" width="210" x="550" y="630" as="geometry" />
        </mxCell>
        <mxCell id="k4" parent="1" style="rounded=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=9;fontStyle=1" value="PTRACE_CONT&#xa;Tracer resumes tracee&#xa;Tool executes normally" vertex="1">
          <mxGeometry height="50" width="210" x="550" y="790" as="geometry" />
        </mxCell>
        <mxCell id="k5" parent="1" style="rounded=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=9;fontStyle=1" value="Process exit()&#xa;Kernel delivers TE_EXITED to tracer" vertex="1">
          <mxGeometry height="40" width="210" x="550" y="890" as="geometry" />
        </mxCell>
        <mxCell id="ka1" edge="1" parent="1" source="k1" style="strokeWidth=2;strokeColor=#c62828" target="k2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ka2" edge="1" parent="1" source="k2" style="strokeWidth=2;strokeColor=#c62828" target="k3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ka3" edge="1" parent="1" source="k3" style="strokeWidth=2;strokeColor=#c62828" target="k4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ka4" edge="1" parent="1" source="k4" style="strokeWidth=2;strokeColor=#c62828" target="k5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xk1" edge="1" parent="1" source="t2" style="strokeWidth=2;strokeColor=#8A8A8A;dashed=1;dashPattern=4 4" target="k1" value="fork child">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xk2" edge="1" parent="1" source="k2" style="strokeWidth=2;strokeColor=#8A8A8A;dashed=1;dashPattern=4 4" target="t4" value="waitpid() returns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xk3" edge="1" parent="1" source="t7" style="strokeWidth=2;strokeColor=#8A8A8A;dashed=1;dashPattern=4 4;exitX=0.973;exitY=0.076;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.005;entryY=0.195;entryDx=0;entryDy=0;entryPerimeter=0;" target="k3" value="read/write mem">
          <mxGeometry relative="1" x="0.3062" y="-4" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="290" y="650" />
              <mxPoint x="450" y="650" />
