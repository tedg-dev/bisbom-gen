          <mxGeometry height="230" width="400" x="78" y="375" as="geometry" />
        </mxCell>
        <mxCell id="oTree" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10;align=center;verticalAlign=middle;" value="bomsh_omnibor_treedb&#xa;JAR → .class → source (SHA-1)" vertex="1">
