        </mxCell>
        <mxCell id="rawlog" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=5;verticalAlign=top" value="bomsh_hook_raw_logfile (text)&#xa;&#xa;One record per execve():&#xa;pid | tool | input_files[] | output_files[]&#xa;     | input_hashes[] | output_hashes[]&#xa;&#xa;Example (compile): main.go,util.go → main.a&#xa;Example (link): *.a → binary" vertex="1">
          <mxGeometry height="105" width="220" x="40" y="608" as="geometry" />
        </mxCell>
        <mxCell id="bomsh-py" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;verticalAlign=top" value="bomsh_create_bom.py&#xa;(Python script)&#xa;&#xa;Parses raw logfile,&#xa;builds dependency graph" vertex="1">
          <mxGeometry height="90" width="150" x="311" y="618" as="geometry" />
        </mxCell>
        <mxCell id="treedb" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=5;verticalAlign=top" value="bomsh_omnibor_treedb&#xa;(JSON file)&#xa;&#xa;{ &quot;gitoid:sha256:abc123...&quot;:&#xa;    &quot;vendor/github.com/fatih/color/color.go&quot;,&#xa;  &quot;gitoid:sha256:def456...&quot;:&#xa;    &quot;GOROOT/src/fmt/print.go&quot;, ... }" vertex="1">
          <mxGeometry height="100" width="200" x="515" y="528" as="geometry" />
        </mxCell>
        <mxCell id="adg" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=5;verticalAlign=top" value="ADG (.omnibor/ directory)&#xa;&#xa;One file per output artifact:&#xa;gitoid:sha256:&lt;binary_hash&gt;&#xa;├─ blob &lt;module1.a_hash&gt;&#xa;├─ blob &lt;module2.a_hash&gt;&#xa;└─ blob &lt;stdlib.a_hash&gt;&#xa;&#xa;Maps: binary → all .a inputs" vertex="1">
          <mxGeometry height="110" width="175" x="515" y="648" as="geometry" />
        </mxCell>
        <mxCell id="c2" edge="1" parent="1" source="rawlog" target="bomsh-py">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" edge="1" parent="1" source="bomsh-py" target="treedb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" edge="1" parent="1" source="bomsh-py" target="adg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2-note" parent="1" style="shape=note;size=14;fillColor=#e0e0e0;strokeColor=#9e9e9e;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;whiteSpace=wrap" value="SECTION 2 DATA FLOW (Go-specific):&#xa;1. go build runs with LD_PRELOAD=libbomsh.so (shim in each child)&#xa;2. Shim interposes libc exec() before each tool runs&#xa;3. Shim inspects: which tool? what inputs? what outputs?&#xa;4. Computes SHA-256 hash (gitoid) of each file&#xa;5. Appends record to raw logfile, then calls the real exec()&#xa;6. After build: bomsh_create_bom.py parses logfile:&#xa;   • bomsh_omnibor_treedb: JSON mapping gitoid → path&#xa;   • ADG: per-artifact file listing input gitoids&#xa;&#xa;Caveat (Go static toolchain):&#xa;• Go tools may exec via raw syscalls, defeating LD_PRELOAD&#xa;• Fallback: node-level eBPF / Linux audit&#xa;• ptrace/bomtrace2 remains the standalone escape hatch" vertex="1">
          <mxGeometry height="192" width="250" x="750" y="508" as="geometry" />
        </mxCell>
