        </mxCell>
        <mxCell id="p2-windsurf-opt-text" parent="1" style="text;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;" value="Full interactive development experience&#xa;&#xa;1. Clone omnibor-analysis from GitHub&#xa;2. Cascade loads .windsurf/ rules&#xa;3. /add-repo → auto-discover + configure&#xa;4. /run-analysis → AI-guided build + SBOM" vertex="1">
          <mxGeometry height="100" width="230" x="752" y="708" as="geometry" />
        </mxCell>
