        </mxCell>
        <mxCell id="e_q1_no" edge="1" parent="1" source="q1" style="edgeStyle=orthogonalEdgeStyle;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;" target="q2" value="NO">
