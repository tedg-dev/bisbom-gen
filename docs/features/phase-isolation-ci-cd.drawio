        <mxCell id="e_b_p1_label" parent="1" style="text;html=1;fontSize=8;fontStyle=2;fontColor=#6c8ebf;align=center;" value="target/*.jar&#xa;on runner FS" vertex="1">
          <mxGeometry height="24" width="80" x="285" y="175" as="geometry" />
        </mxCell>

        <!-- Phase 1 Container -->
        <mxCell id="p1_ctr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontStyle=1;verticalAlign=top;" value="Phase 1 Container&lt;br&gt;&lt;font style=&quot;font-weight:normal;font-size:9px;color:#2471a3&quot;&gt;ghcr.io/tedg-dev/omnibor-sidecar&lt;/font&gt;" vertex="1">
