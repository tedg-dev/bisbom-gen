<mxfile host="Electron" agent="Cascade AI" pages="1">
  <diagram id="phase-iso-cicd" name="Phase Isolation CI/CD">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="Phase Isolation in CI/CD — Separate Jobs with Artifact Transfer" vertex="1">
          <mxGeometry height="30" width="1100" x="150" y="15" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=10;fontStyle=2;align=center;fontColor=#666666;" value="Job 1 (customer build site) produces artifacts.  Job 2 (analysis service) consumes them via GitHub Actions artifact mechanism — no shared filesystem." vertex="1">
          <mxGeometry height="18" width="1200" x="100" y="45" as="geometry" />
        </mxCell>

        <!-- ═══════════ Job 1: build-and-phase1 ═══════════ -->
        <mxCell id="job1_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;dashed=0;" value="" vertex="1">
          <mxGeometry height="340" width="580" x="30" y="80" as="geometry" />
        </mxCell>
        <mxCell id="job1_label" parent="1" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#1a5276;" value="GitHub Actions Job 1: build-and-phase1" vertex="1">
          <mxGeometry height="22" width="400" x="50" y="84" as="geometry" />
        </mxCell>
        <mxCell id="job1_desc" parent="1" style="text;html=1;fontSize=9;fontStyle=2;align=left;fontColor=#2980b9;" value="Simulates customer build environment.  Runs on ubuntu-latest runner." vertex="1">
          <mxGeometry height="16" width="500" x="50" y="105" as="geometry" />
        </mxCell>

        <!-- Build Container -->
        <mxCell id="build_ctr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontStyle=1;verticalAlign=top;" value="Build Container&lt;br&gt;&lt;font style=&quot;font-weight:normal;font-size:9px;color:#b7950b&quot;&gt;amazoncorretto:21-al2023&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="240" x="50" y="130" as="geometry" />
        </mxCell>
        <mxCell id="build_step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=9;" value="1. dnf install tar gzip" vertex="1">
          <mxGeometry height="28" width="210" x="65" y="170" as="geometry" />
        </mxCell>
        <mxCell id="build_step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=9;" value="2. mvn package -q" vertex="1">
          <mxGeometry height="28" width="210" x="65" y="205" as="geometry" />
        </mxCell>

        <!-- Arrow: Build → Phase 1 -->
        <mxCell id="e_b_p1" edge="1" parent="1" source="build_ctr" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;" target="p1_ctr">
          <mxGeometry relative="1" as="geometry" />
