<mxfile host="Electron" agent="Cascade AI">
  <diagram id="java-inline-mech" name="Inline Interception Mechanism">
    <mxGraphModel dx="1592" dy="1089" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;" value="Java Inline-Hashing Interception — LD_PRELOAD shim (no build-system change)" vertex="1">
          <mxGeometry height="30" width="1000" x="90" y="12" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=12;fontStyle=2;align=center;fontColor=#666666;" value="Injected via two environment variables in the CI/CD YAML. pom.xml / build.gradle / mvn / gradle are untouched." vertex="1">
          <mxGeometry height="20" width="1000" x="90" y="42" as="geometry" />
        </mxCell>
        <mxCell id="yaml" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" value="&lt;b&gt;CI/CD YAML — the ONLY customer-visible change&lt;/b&gt;&#xa;export LD_PRELOAD=/opt/bisbom/lib/libbisbom_java_intercept.so&#xa;export OMNIBOR_CAPTURE_LOG=$PWD/.omnibor/capture.jsonl&#xa;mvn -B package -DskipTests      # ← identical to existing command" vertex="1">
          <mxGeometry height="90" width="1020" x="80" y="80" as="geometry" />
        </mxCell>
        <mxCell id="jvmBox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=8;" value="Build JVM process(es)  —  javac / jar / Maven / Gradle  (UNMODIFIED)" vertex="1">
          <mxGeometry height="470" width="620" x="80" y="200" as="geometry" />
        </mxCell>
        <mxCell id="javac" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" value="javac compiles sources&#xa;writes *.class" vertex="1">
          <mxGeometry height="60" width="250" x="110" y="245" as="geometry" />
        </mxCell>
        <mxCell id="jar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" value="jar / Jar task packages&#xa;writes *.jar (final close/rename)" vertex="1">
          <mxGeometry height="60" width="250" x="410" y="245" as="geometry" />
        </mxCell>
        <mxCell id="libc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" value="glibc  close() / rename() / renameat()" vertex="1">
          <mxGeometry height="45" width="550" x="110" y="345" as="geometry" />
        </mxCell>
        <mxCell id="aJavac" edge="1" parent="1" source="javac" style="endArrow=classic;strokeColor=#6c8ebf;strokeWidth=2;" target="libc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aJar" edge="1" parent="1" source="jar" style="endArrow=classic;strokeColor=#6c8ebf;strokeWidth=2;" target="libc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="shim" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;strokeWidth=3;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" value="&lt;b&gt;libbisbom_java_intercept.so  (LD_PRELOAD interposer)&lt;/b&gt;&#xa;&#xa;On each finalized path under the build root:&#xa;  if *.class → hash bytes (SHA-1 + SHA-256), parse SourceFile + class name&#xa;  if *.jar/*.war/*.ear → hash bytes (SHA-1 + SHA-256), read central directory&#xa;                              (enumerate .class entries + per-entry SHA-1)&#xa;then delegate to the real close()/rename().  Classify by suffix + build-root,&#xa;NEVER by repo name (generic / config-driven)." vertex="1">
          <mxGeometry height="150" width="550" x="110" y="441" as="geometry" />
        </mxCell>
        <mxCell id="aLibcShim" edge="1" parent="1" source="libc" style="endArrow=classic;strokeColor=#e65100;strokeWidth=3;" target="shim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aLibcShimLbl" connectable="0" parent="1" style="edgeLabel;html=1;fontSize=10;fontColor=#e65100;fontStyle=1;fillColor=#ffffff;" value="interposed before real syscall" vertex="1">
          <mxGeometry height="16" width="190" x="300" y="398" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="text;html=1;fontSize=10;fontStyle=2;align=left;fontColor=#e65100;" value="Bytes are already in the page cache from the write — hashing adds only CPU, amortized into build I/O (target +1–3%)." vertex="1">
          <mxGeometry height="30" width="560" x="105" y="596" as="geometry" />
        </mxCell>
        <mxCell id="daemonNote" parent="1" style="text;html=1;fontSize=10;fontStyle=2;align=left;fontColor=#c0392b;" value="Gradle: disable daemon reuse via env (GRADLE_OPTS=-Dorg.gradle.daemon=false) so every compiling JVM inherits the preload&amp;nbsp;&lt;div&gt;— env only, no command change (validation item V3).&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="560" x="103" y="623" as="geometry" />
        </mxCell>
        <mxCell id="log" parent="1" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=11;fontStyle=1;align=center;" value="capture.jsonl&#xa;(append-only)&#xa;&#xa;one event per&#xa;finalized&#xa;.class / .jar" vertex="1">
          <mxGeometry height="150" width="320" x="760" y="400" as="geometry" />
        </mxCell>
        <mxCell id="aShimLog" edge="1" parent="1" source="shim" style="endArrow=classic;strokeColor=#1e8449;strokeWidth=3;" target="log">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aShimLogLbl" connectable="0" parent="1" style="edgeLabel;html=1;fontSize=10;fontColor=#1e8449;fontStyle=1;fillColor=#ffffff;" value="append event" vertex="1">
          <mxGeometry height="16" width="120" x="700" y="388" as="geometry" />
        </mxCell>
        <mxCell id="event" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontFamily=Courier New;" value="{&quot;kind&quot;:&quot;class&quot;,&quot;path&quot;:&quot;App.class&quot;,&#xa; &quot;sha1&quot;:&quot;..&quot;,&quot;gitoid&quot;:&quot;..&quot;,&#xa; &quot;source_file&quot;:&quot;App.java&quot;,&#xa; &quot;class_name&quot;:&quot;com.example.App&quot;}&#xa;{&quot;kind&quot;:&quot;jar&quot;,&quot;path&quot;:&quot;app.jar&quot;,&#xa; &quot;sha1&quot;:&quot;..&quot;,&quot;gitoid&quot;:&quot;..&quot;,&#xa; &quot;entries&quot;:[{&quot;name&quot;:&quot;..&quot;,&quot;sha1&quot;:&quot;..&quot;}]}" vertex="1">
          <mxGeometry height="120" width="320" x="760" y="565" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
