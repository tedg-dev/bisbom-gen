        </mxCell>
        <mxCell id="job2_label" parent="1" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#1e8449;" value="GitHub Actions Job 2: phase2-analyze &amp;nbsp; &lt;font style=&quot;font-size:10px;font-weight:normal;color:#27ae60&quot;&gt;(needs: build-and-phase1)&lt;/font&gt;" vertex="1">
          <mxGeometry height="22" width="500" x="50" y="454" as="geometry" />
        </mxCell>
        <mxCell id="job2_desc" parent="1" style="text;html=1;fontSize=9;fontStyle=2;align=left;fontColor=#27ae60;" value="Simulates analysis service (Corona).  Different runner — no shared filesystem with Job 1." vertex="1">
          <mxGeometry height="16" width="500" x="50" y="475" as="geometry" />
        </mxCell>

        <!-- Download -->
        <mxCell id="download" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;strokeWidth=2;fontSize=10;fontStyle=1;" value="6. actions/download-artifact&#xa;(phase1-artifacts + build-output)" vertex="1">
          <mxGeometry height="40" width="240" x="50" y="500" as="geometry" />
        </mxCell>

        <!-- Checkout -->
        <mxCell id="checkout" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;" value="7. actions/checkout&#xa;(for pom.xml structure)" vertex="1">
          <mxGeometry height="35" width="140" x="310" y="502" as="geometry" />
