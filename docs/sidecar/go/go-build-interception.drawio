        <mxCell id="meta-label" parent="1" style="text;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=3;verticalAlign=top;rounded=1" value="Shim captures per exec():&#xa;• tool name (compile, link)&#xa;• input files + SHA-256 hashes&#xa;• output files + SHA-256 hashes" vertex="1">
