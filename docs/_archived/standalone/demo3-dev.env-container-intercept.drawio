        <mxCell id="Oh_HtpFAZzUBUrxv-mm9-37" parent="1" style="rounded=1;fillColor=#f9f9f9;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" value="Standalone vs Sidecar Mode - Key Differences" vertex="1">
          <mxGeometry height="238" width="280" x="750" y="72" as="geometry" />
        </mxCell>
        <mxCell id="Oh_HtpFAZzUBUrxv-mm9-38" parent="1" style="text;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;" value="STANDALONE MODE (this diagram):&#xa;  ✓ Self-contained, portable&#xa;  ✓ No host dependencies needed&#xa;  ✓ Ideal for OSS evaluation&#xa;  ✓ Reproducible across machines&#xa;  ✓ Container provides all toolchains&#xa;  • ~20–60% build overhead (ptrace)&#xa;  • SBOM reflects actual build output&#xa;&#xa;SIDECAR MODE (planned):&#xa;  • Uses YOUR gcc/clang version&#xa;  • CC= wrapper, no ptrace&#xa;  • ~3–5% overhead&#xa;  • SBOM matches production binary&#xa;  • Integrates into existing CI/CD" vertex="1">
          <mxGeometry height="215" width="250" x="760" y="97" as="geometry" />
        </mxCell>
        <mxCell id="Oh_HtpFAZzUBUrxv-mm9-39" parent="1" style="rounded=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" value="How Standalone Mode Works" vertex="1">
          <mxGeometry height="220" width="270" x="760" y="353" as="geometry" />
        </mxCell>
        <mxCell id="Oh_HtpFAZzUBUrxv-mm9-40" parent="1" style="text;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;fontFamily=Courier New;" value="# Start container&#xa;docker compose run --name demo \&#xa;  omnibor-env sleep infinity&#xa;&#xa;# Clone + build inside container&#xa;docker exec demo bash -c \&#xa;  &quot;cd /repos/openosc &amp;&amp; \&#xa;   autoreconf -vfi &amp;&amp; \&#xa;   ./configure &amp;&amp; \&#xa;   bomtrace3 make -j$(nproc)&quot;&#xa;&#xa;# Generate ADG from logfile&#xa;bomsh_create_bom.py -r /tmp/...sha1" vertex="1">
          <mxGeometry height="175" width="295" x="765" y="375.5" as="geometry" />
        </mxCell>
        <mxCell id="Oh_HtpFAZzUBUrxv-mm9-41" parent="1" style="rounded=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" value="Performance: ptrace Overhead" vertex="1">
          <mxGeometry height="180" width="212.5" x="782.5" y="632" as="geometry" />
        </mxCell>
        <mxCell id="Oh_HtpFAZzUBUrxv-mm9-42" parent="1" style="text;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;" value="bomtrace3 (ptrace):&#xa;  Per-invocation: ~1–5ms overhead&#xa;  Context switches: 200–500 per gcc&#xa;  Total: 20–60% build overhead&#xa;&#xa;By project size:&#xa;  Small  (&lt;100 files): ~43%&#xa;  Medium (100–500):    ~36–48%&#xa;  Large  (500–2500):   ~60%&#xa;  Very large (2500+):  ~37–46%" vertex="1">
          <mxGeometry height="140" width="205" x="792.5" y="657" as="geometry" />
