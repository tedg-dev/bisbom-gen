        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666666;" value="Add a single Phase 1 step after your existing build. It runs in seconds and uploads metadata to Corona. SBOM generation in Corona is asynchronous and never blocks Test or Deploy." vertex="1">
          <mxGeometry height="22" width="1100" x="40" y="42" as="geometry" />
        </mxCell>
        <mxCell id="checkout" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;verticalAlign=middle;" value="Checkout" vertex="1">
