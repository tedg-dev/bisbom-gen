        </mxCell>
        <mxCell id="phase2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" value="&lt;b&gt;Phase 2: SPDX generation&lt;/b&gt;&#xa;(runs in Corona, asynchronously)&#xa;&#xa;• reads treedb + Maven/Gradle dep tree&#xa;• assembles + validates SPDX 2.3 SBOM&#xa;• stores under Product / Release / Image" vertex="1">
          <mxGeometry height="108" width="227" x="716" y="246" as="geometry" />
        </mxCell>
        <mxCell id="coronanote" parent="1" style="text;html=1;fontSize=10;fontStyle=2;align=left;fontColor=#2e7d32;" value="All SBOM assembly happens here — zero added load on your build pipeline." vertex="1">
          <mxGeometry height="26" width="350" x="671.5" y="359" as="geometry" />
        </mxCell>
        <mxCell id="eup" edge="1" parent="1" source="meta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#d79b00;strokeWidth=3;fontSize=10;fontColor=#b7950b;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s3" value="upload ~1–2 KB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es3" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2e7d32;strokeWidth=2;dashed=1;" target="phase2">
