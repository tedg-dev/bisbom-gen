        <mxCell id="foot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;" value="Contract = phase1_manifest.json + referenced artifacts. Phase 2 is decoupled: it can run in another job, host, or Corona, minutes or hours later, with the build host long gone." vertex="1">
