        </mxCell>
        <mxCell id="BPPCVkG6UmSerM5-dHMs-37" parent="1" style="rounded=1;fillColor=#f9f9f9;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" value="Sidecar vs Standalone Mode — Key Differences" vertex="1">
          <mxGeometry height="250" width="300" x="750" y="80" as="geometry" />
        </mxCell>
        <mxCell id="BPPCVkG6UmSerM5-dHMs-38" parent="1" style="text;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;" value="SIDECAR MODE (this diagram):&#xa;  ✓ Uses YOUR gcc/clang version&#xa;  ✓ CC= wrapper, no ptrace&#xa;  ✓ ~3–5% overhead (vs 20–60%)&#xa;  ✓ SBOM matches production binary&#xa;  ✓ Integrates into existing CI/CD&#xa;  ✓ No container toolchains needed&#xa;&#xa;STANDALONE MODE (current):&#xa;  • Container provides gcc 11&#xa;  • bomtrace3 via ptrace&#xa;  • ~20–60% overhead&#xa;  • SBOM matches container build&#xa;  • Self-contained, portable&#xa;  • Ideal for OSS evaluation" vertex="1">
          <mxGeometry height="215" width="250" x="760" y="105" as="geometry" />
        </mxCell>
        <mxCell id="BPPCVkG6UmSerM5-dHMs-39" parent="1" style="rounded=1;fillColor=#e8f5e9;strokeColor=#66bb6a;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" value="How to Activate Sidecar Mode" vertex="1">
          <mxGeometry height="220" width="310" x="750" y="362" as="geometry" />
        </mxCell>
        <mxCell id="BPPCVkG6UmSerM5-dHMs-40" parent="1" style="text;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;fontFamily=Courier New;" value="# Install wrapper scripts&#xa;cp /opt/bomsh/gcc-wrapper /usr/local/bin/&#xa;cp /opt/bomsh/g++-wrapper /usr/local/bin/&#xa;&#xa;# Set CC/CXX in your build&#xa;export CC=/opt/bomsh/gcc-wrapper&#xa;export CXX=/opt/bomsh/g++-wrapper&#xa;&#xa;# Build normally — wrapper is transparent&#xa;make -j$(nproc)&#xa;&#xa;# Generate ADG from logfile&#xa;bomsh_create_bom.py -r /tmp/...sha1" vertex="1">
          <mxGeometry height="175" width="295" x="755" y="384.5" as="geometry" />
        </mxCell>
        <mxCell id="BPPCVkG6UmSerM5-dHMs-41" parent="1" style="rounded=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" value="Performance: Sidecar vs ptrace" vertex="1">
          <mxGeometry height="180" width="245" x="777.5" y="640" as="geometry" />
        </mxCell>
        <mxCell id="BPPCVkG6UmSerM5-dHMs-42" parent="1" style="text;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;" value="bomtrace3 (ptrace):&#xa;  Per-invocation: ~1–5ms overhead&#xa;  Context switches: 200–500 per gcc&#xa;  Total: 20–60% build overhead&#xa;&#xa;CC= wrapper (sidecar):&#xa;  Per-invocation: ~2ms (hash only)&#xa;  Context switches: 0 (no ptrace)&#xa;  Total: 3–5% build overhead&#xa;  Reduction: ~90% less overhead" vertex="1">
          <mxGeometry height="140" width="205" x="787.5" y="665" as="geometry" />
        </mxCell>
