        <mxCell id="cnmnuk9PWWDBNoqCXdrO-8" parent="1" style="text;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=3;" value="Jenkins, GitHub Actions, GitLab CI, etc.&#xa;&#xa;Sidecar mode (planned):&#xa;  1. Install interception tools in CI step&#xa;  2. CC= wrappers wrap native make/build&#xa;  3. Your toolchain, your build — we observe&#xa;  4. SPDX SBOM matches production artifact" vertex="1">
          <mxGeometry height="100" width="200" x="443" y="698" as="geometry" />
        </mxCell>
        <mxCell id="cnmnuk9PWWDBNoqCXdrO-9" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" value="Windsurf IDE + Cascade AI" vertex="1">
