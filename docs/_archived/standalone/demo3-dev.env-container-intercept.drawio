        <mxCell id="BPPCVkG6UmSerM5-dHMs-35" parent="1" style="text;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=8;spacingTop=3;" value="Packages: your binary + deps&#xa;Files: every .c/.h with gitoid&#xa;Relationships: STATIC_LINK,&#xa;  DYNAMIC_LINK, BUILD_TOOL_OF&#xa;&#xa;Reflects YOUR production build" vertex="1">
