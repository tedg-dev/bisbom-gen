        <mxCell id="parser" parent="1" style="rounded=1;fillColor=#e6d0de;strokeColor=#996185;fontSize=8;align=left;spacingLeft=5;verticalAlign=top" value="AdgParser (app/spdx/parser.py)&#xa;&#xa;Reads treedb, classifies artifacts:&#xa;/usr/lib/... → system_lib&#xa;/usr/include/... → system_header&#xa;/workspace/repos/... → project_source&#xa;*.o → build_intermediate&#xa;crt*.o → crt_object" vertex="1">
