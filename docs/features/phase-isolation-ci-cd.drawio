        <!-- ═══════════ Job 2: phase2-analyze ═══════════ -->
        <mxCell id="job2_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#27ae60;strokeWidth=2;dashed=0;" value="" vertex="1">
