          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1assemble" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" value="&lt;b&gt;generate_adg() — assemble (no rescan)&lt;/b&gt;&#xa;treedb from capture.jsonl&#xa;+ mvn dependency:tree (declared graph)" vertex="1">
          <mxGeometry height="70" width="400" x="78" y="280" as="geometry" />
        </mxCell>
        <mxCell id="aP1b" edge="1" parent="1" source="p1cap" style="endArrow=classic;strokeColor=#d6b656;strokeWidth=2;" target="p1assemble">
