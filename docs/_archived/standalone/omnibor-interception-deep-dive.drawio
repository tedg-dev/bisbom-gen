  </diagram>
  <diagram name="2 - gcc/clang Compiler Interception" id="gcc-interception">
    <mxGraphModel dx="1422" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="g-title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=center" value="Deep Dive: gcc/clang Compiler Interception" vertex="1">
          <mxGeometry height="40" width="700" x="450" y="20" as="geometry" />
        </mxCell>
        <mxCell id="g-sub" parent="1" style="text;fontSize=11;align=center;fontColor=#666" value="bomsh_process_gcc_command() - the most complex handler in bomsh_hook.c" vertex="1">
          <mxGeometry height="25" width="700" x="450" y="55" as="geometry" />
        </mxCell>
        <!-- PRE-EXEC BOX -->
        <mxCell id="pre-box" parent="1" style="rounded=0;fillColor=none;strokeColor=#d6b656;strokeWidth=3" value="" vertex="1">
          <mxGeometry height="870" width="580" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="pre-lbl" parent="1" style="text;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;rounded=1" value="PRE-EXEC PHASE (before gcc runs)" vertex="1">
          <mxGeometry height="26" width="578" x="41" y="100" as="geometry" />
        </mxCell>
        <mxCell id="g1" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontStyle=1" value="Incoming cmd_data:&#xa;path = /usr/bin/gcc&#xa;argv = [gcc, -c, main.c, -o, main.o]&#xa;pwd = /workspace/repos/curl/src" vertex="1">
          <mxGeometry height="65" width="260" x="200" y="145" as="geometry" />
        </mxCell>
        <mxCell id="g2" parent="1" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1" value="Is -c flag&#xa;in argv?&#xa;gcc_is_compile_only()" vertex="1">
          <mxGeometry height="80" width="200" x="230" y="230" as="geometry" />
        </mxCell>
        <mxCell id="g3l" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontStyle=1" value="Compile-only mode&#xa;Single .c → single .o" vertex="1">
          <mxGeometry height="40" width="160" x="80" y="335" as="geometry" />
        </mxCell>
        <mxCell id="g3r" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontStyle=1" value="Linking mode&#xa;Multiple .o/.a → binary" vertex="1">
          <mxGeometry height="40" width="160" x="380" y="335" as="geometry" />
        </mxCell>
        <mxCell id="g4" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=1" value="get_outfile_in_argv(argv)&#xa;Parse -o flag → output_file = main.o&#xa;If -o /dev/null → skip (preprocessor-only)" vertex="1">
          <mxGeometry height="50" width="320" x="170" y="400" as="geometry" />
        </mxCell>
        <mxCell id="g5" parent="1" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1" value="Has -MD/-MMD&#xa;already?" vertex="1">
          <mxGeometry height="70" width="170" x="245" y="475" as="geometry" />
        </mxCell>
        <mxCell id="g6l" parent="1" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9" value="Dep file will be generated&#xa;by gcc automatically&#xa;No modification needed" vertex="1">
          <mxGeometry height="50" width="180" x="60" y="575" as="geometry" />
        </mxCell>
        <mxCell id="g6r" parent="1" style="rounded=1;fillColor=#ffe0e0;strokeColor=#c62828;fontSize=8;strokeWidth=2;align=left;spacingLeft=6;verticalAlign=top" value="INJECT DEP FLAGS&#xa;bomsh_execve_instrument_for_dependency()&#xa;&#xa;Uses PTRACE_POKEDATA to write&#xa;into tracee stack memory:&#xa;  -MD -MF /tmp/bomsh_hook_target_&#xa;  dependency_pid{PID}&#xa;&#xa;Forces gcc to produce .d file&#xa;listing every included header" vertex="1">
          <mxGeometry height="145" width="230" x="340" y="560" as="geometry" />
        </mxCell>
        <mxCell id="g7" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=1" value="bomsh_add_cmd(tcp, pwd, root, path, argv)&#xa;Store cmd_data in bomsh_cmds[PID % 1024]" vertex="1">
          <mxGeometry height="40" width="330" x="165" y="740" as="geometry" />
        </mxCell>
        <mxCell id="g8" parent="1" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;fontStyle=1;align=center" value="PTRACE_CONT: gcc runs..." vertex="1">
          <mxGeometry height="30" width="280" x="190" y="810" as="geometry" />
        </mxCell>
        <mxCell id="ga1" edge="1" parent="1" source="g1" target="g2" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ga2" edge="1" parent="1" source="g2" target="g3l" style="strokeWidth=2;strokeColor=#333" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ga3" edge="1" parent="1" source="g2" target="g3r" style="strokeWidth=2;strokeColor=#333" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ga4" edge="1" parent="1" source="g3l" target="g4" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ga5" edge="1" parent="1" source="g3r" target="g4" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ga6" edge="1" parent="1" source="g4" target="g5" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ga7" edge="1" parent="1" source="g5" target="g6l" style="strokeWidth=2;strokeColor=#333" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ga8" edge="1" parent="1" source="g5" target="g6r" style="strokeWidth=2;strokeColor=#333" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ga9" edge="1" parent="1" source="g6l" target="g7" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ga10" edge="1" parent="1" source="g6r" target="g7" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ga11" edge="1" parent="1" source="g7" target="g8" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- POST-EXEC BOX -->
        <mxCell id="post-box" parent="1" style="rounded=0;fillColor=none;strokeColor=#d6b656;strokeWidth=3" value="" vertex="1">
          <mxGeometry height="870" width="580" x="680" y="100" as="geometry" />
        </mxCell>
        <mxCell id="post-lbl" parent="1" style="text;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;rounded=1" value="POST-EXEC PHASE (after gcc exits)" vertex="1">
          <mxGeometry height="26" width="578" x="681" y="100" as="geometry" />
        </mxCell>
        <mxCell id="h1" parent="1" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;fontStyle=1;align=center" value="gcc exits with status 0" vertex="1">
          <mxGeometry height="30" width="280" x="830" y="150" as="geometry" />
        </mxCell>
        <mxCell id="h2" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=1" value="bomsh_remove_cmd(PID)&#xa;Retrieve stored cmd_data from hash table" vertex="1">
          <mxGeometry height="40" width="280" x="830" y="200" as="geometry" />
        </mxCell>
        <mxCell id="h3" parent="1" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1" value="Dependency&#xa;file exists?" vertex="1">
          <mxGeometry height="65" width="140" x="900" y="265" as="geometry" />
        </mxCell>
        <mxCell id="h4l" parent="1" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=8;align=left;spacingLeft=5;verticalAlign=top" value="bomsh_cmd_read_depend_file()&#xa;&#xa;Reads .d file generated by gcc:&#xa;  main.o: main.c \&#xa;   curl.h stdio.h stdlib.h&#xa;&#xa;Parses into depends_array[]:&#xa;[main.c, curl.h, stdio.h, ...]&#xa;&#xa;Captures ALL transitive&#xa;#include dependencies!" vertex="1">
          <mxGeometry height="160" width="210" x="710" y="360" as="geometry" />
        </mxCell>
        <mxCell id="h4r" parent="1" style="rounded=1;fillColor=#ffe0e0;strokeColor=#c62828;fontSize=9" value="Fallback: bomsh_try_get_gcc_subfiles()&#xa;Parse argv for .c files only&#xa;(misses transitive #includes)" vertex="1">
          <mxGeometry height="55" width="210" x="1030" y="370" as="geometry" />
        </mxCell>
        <mxCell id="h5" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=1" value="Hash every input file:&#xa;bomsh_get_hash() → calculate_sha256_omnibor()&#xa;SHA256(&quot;blob {size}\0&quot; + content) → 64 hex chars" vertex="1">
          <mxGeometry height="55" width="340" x="800" y="560" as="geometry" />
        </mxCell>
        <mxCell id="h6" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=1" value="Hash the output file (main.o)&#xa;File now exists after gcc completed" vertex="1">
          <mxGeometry height="40" width="340" x="800" y="645" as="geometry" />
        </mxCell>
        <mxCell id="h7" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;strokeWidth=2;align=left;spacingLeft=8;verticalAlign=top" value="bomsh_record_raw_info(cmd)&#xa;Write to raw_logfile:&#xa;&#xa;outfile: 7a8b9c.. path: /workspace/.../main.o&#xa;infile: 1234ab.. path: /workspace/.../main.c&#xa;infile: abcdef.. path: /workspace/.../curl.h&#xa;infile: fedcba.. path: /usr/include/stdio.h&#xa;infile: 112233.. path: /usr/include/stdlib.h" vertex="1">
          <mxGeometry height="125" width="350" x="795" y="720" as="geometry" />
        </mxCell>
        <mxCell id="ha1" edge="1" parent="1" source="h1" target="h2" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ha2" edge="1" parent="1" source="h2" target="h3" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ha3" edge="1" parent="1" source="h3" target="h4l" style="strokeWidth=2;strokeColor=#333" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ha4" edge="1" parent="1" source="h3" target="h4r" style="strokeWidth=2;strokeColor=#333" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ha5" edge="1" parent="1" source="h4l" target="h5" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ha6" edge="1" parent="1" source="h4r" target="h5" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ha7" edge="1" parent="1" source="h5" target="h6" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ha8" edge="1" parent="1" source="h6" target="h7" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- NOTES -->
        <mxCell id="gn1" parent="1" style="shape=note;size=14;fillColor=#e0e0e0;strokeColor=#9e9e9e;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;whiteSpace=wrap" value="WHY DEP FILE INJECTION MATTERS:&#xa;&#xa;Without -MD, gcc does NOT report which headers it opened.&#xa;To know the full #include graph:&#xa;&#xa;Option A: Trace every open() syscall (very expensive)&#xa;Option B: Ask gcc itself via -MD -MF flag (cheap)&#xa;&#xa;bomtrace3 uses Option B: inject the flag before gcc runs.&#xa;gcc then writes a .d file listing every header it included.&#xa;Same mechanism build systems use for incremental builds.&#xa;&#xa;Source: bomsh_hook.c&#xa;  bomsh_execve_instrument_for_dependency()" vertex="1">
          <mxGeometry height="200" width="300" x="50" y="990" as="geometry" />
        </mxCell>
        <mxCell id="gn2" parent="1" style="shape=note;size=14;fillColor=#e0e0e0;strokeColor=#9e9e9e;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;whiteSpace=wrap" value="GITOID HASH FORMAT (OmniBOR Standard):&#xa;&#xa;Identical to git hash-object:&#xa;SHA256(&quot;blob &quot; + decimal_size + &quot;\0&quot; + raw_bytes)&#xa;&#xa;Example for 1234-byte file:&#xa;SHA256(&quot;blob 1234\0&quot; + file_content) → 64 hex chars&#xa;&#xa;Verify: git hash-object --algorithm=sha256 file.c&#xa;produces the same hash as bomtrace3.&#xa;&#xa;Source: bomsh_hook.c&#xa;  calculate_sha256_omnibor()" vertex="1">
          <mxGeometry height="190" width="300" x="400" y="990" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 - ar and ld Interception" id="ar-ld-interception">
    <mxGraphModel dx="1422" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="al-title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=center" value="Deep Dive: ar (Archiver) and ld (Linker) Interception" vertex="1">
          <mxGeometry height="40" width="700" x="450" y="20" as="geometry" />
        </mxCell>
        <!-- AR SECTION -->
        <mxCell id="ar-box" parent="1" style="rounded=0;fillColor=none;strokeColor=#d6b656;strokeWidth=3" value="" vertex="1">
          <mxGeometry height="430" width="1500" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="ar-lbl" parent="1" style="text;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;align=center;rounded=1" value="ARCHIVER: bomsh_process_ar_command() - bomsh_hook.c" vertex="1">
          <mxGeometry height="26" width="1498" x="41" y="80" as="geometry" />
        </mxCell>
        <mxCell id="ar-cmd" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1" value="Intercepted command:&#xa;ar rcs libcurl.a x509.o ssl.o http.o" vertex="1">
          <mxGeometry height="40" width="310" x="60" y="125" as="geometry" />
        </mxCell>
        <mxCell id="ar-p1" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9" value="Parse argv:&#xa;argv[1] = &quot;rcs&quot; (operation flags)&#xa;argv[2] = libcurl.a → output_file&#xa;argv[3..N] = [x509.o, ssl.o, http.o] → input_files[]" vertex="1">
          <mxGeometry height="65" width="310" x="60" y="185" as="geometry" />
        </mxCell>
        <mxCell id="ar-p2" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;strokeWidth=2;align=left;spacingLeft=6;verticalAlign=top" value="PRE-EXEC: get_hash_of_infiles(cmd)&#xa;&#xa;Hash every .o input NOW (they already exist):&#xa;SHA256(x509.o) → aaa111..&#xa;SHA256(ssl.o)  → bbb222..&#xa;SHA256(http.o) → ccc333..&#xa;&#xa;Why pre-hash? For strip/ranlib the tool&#xa;modifies files in-place. Pre-hashing&#xa;captures the BEFORE state." vertex="1">
          <mxGeometry height="150" width="250" x="60" y="270" as="geometry" />
        </mxCell>
        <mxCell id="ar-run" parent="1" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;fontStyle=1;align=center" value="PTRACE_CONT → ar runs → exit(0)" vertex="1">
          <mxGeometry height="30" width="250" x="500" y="280" as="geometry" />
        </mxCell>
        <mxCell id="ar-h1" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=1" value="POST-EXEC: Hash output&#xa;SHA256(libcurl.a) → ddd444..&#xa;(file now exists)" vertex="1">
          <mxGeometry height="50" width="230" x="850" y="170" as="geometry" />
        </mxCell>
        <mxCell id="ar-h2" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=1;strokeWidth=2" value="bomsh_record_raw_info(cmd)&#xa;Write to raw_logfile" vertex="1">
          <mxGeometry height="35" width="230" x="850" y="240" as="geometry" />
        </mxCell>
        <mxCell id="ar-log" parent="1" style="rounded=1;fillColor=#f0f0f0;strokeColor=#999;fontSize=9;align=left;spacingLeft=8;verticalAlign=top" value="outfile: ddd444.. path: libcurl.a&#xa;infile: aaa111.. path: x509.o&#xa;infile: bbb222.. path: ssl.o&#xa;infile: ccc333.. path: http.o" vertex="1">
          <mxGeometry height="70" width="280" x="1200" y="200" as="geometry" />
        </mxCell>
        <mxCell id="ar-note" parent="1" style="shape=note;size=14;fillColor=#e0e0e0;strokeColor=#9e9e9e;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;whiteSpace=wrap" value="KEY: Pre-hashing vs Post-hashing&#xa;&#xa;Input .o files are hashed in PRE-EXEC (already exist).&#xa;Output .a file is hashed in POST-EXEC (just created).&#xa;&#xa;For strip/ranlib (same-file operations), pre-hashing&#xa;captures the file BEFORE modification.&#xa;Critical for provenance tracking." vertex="1">
          <mxGeometry height="120" width="280" x="60" y="440" as="geometry" />
        </mxCell>
        <mxCell id="ar-a1" edge="1" parent="1" source="ar-cmd" target="ar-p1" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ar-a2" edge="1" parent="1" source="ar-p1" target="ar-p2" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ar-a3" edge="1" parent="1" source="ar-p2" target="ar-run" style="strokeWidth=2;strokeColor=#333;exitX=1;exitY=0;exitDx=0;exitDy=0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ar-a4" edge="1" parent="1" source="ar-run" target="ar-h1" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ar-a5" edge="1" parent="1" source="ar-h1" target="ar-h2" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ar-a6" edge="1" parent="1" source="ar-h2" target="ar-log" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- LD SECTION -->
        <mxCell id="ld-box" parent="1" style="rounded=0;fillColor=none;strokeColor=#d6b656;strokeWidth=3" value="" vertex="1">
          <mxGeometry height="530" width="1500" x="40" y="540" as="geometry" />
        </mxCell>
        <mxCell id="ld-lbl" parent="1" style="text;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;align=center;rounded=1" value="LINKER: bomsh_process_ld_command() + get_all_subfiles_in_ld_cmdline() - bomsh_hook.c" vertex="1">
          <mxGeometry height="26" width="1498" x="41" y="540" as="geometry" />
        </mxCell>
        <mxCell id="ld-cmd" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1" value="Intercepted command:&#xa;ld -o curl main.o libcurl.a -L/usr/lib -lssl -lcrypto -lz" vertex="1">
          <mxGeometry height="40" width="430" x="60" y="590" as="geometry" />
        </mxCell>
        <mxCell id="ld-parse" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=6;verticalAlign=top" value="PRE-EXEC: get_all_subfiles_in_ld_cmdline()&#xa;&#xa;Parse argv token by token:&#xa;-o curl        → output_file&#xa;main.o         → input_files[] (static)&#xa;libcurl.a      → input_files[] (static archive)&#xa;-L/usr/lib     → library_paths[] (search path)&#xa;-lssl          → RESOLVE to filesystem path" vertex="1">
          <mxGeometry height="125" width="260" x="60" y="650" as="geometry" />
        </mxCell>
        <mxCell id="ld-resolve" parent="1" style="rounded=1;fillColor=#b3e5fc;strokeColor=#0288d1;fontSize=8;strokeWidth=2;align=left;spacingLeft=6;verticalAlign=top" value="-l Library Resolution:&#xa;&#xa;For -lssl: search -L paths + system defaults&#xa;→ /usr/lib/x86_64-linux-gnu/libssl.so&#xa;&#xa;Resolved to dynlib_files[]&#xa;(NOT input_files[] - different!)&#xa;&#xa;This distinction enables SPDX to&#xa;differentiate STATIC_LINK from DYNAMIC_LINK" vertex="1">
          <mxGeometry height="145" width="250" x="370" y="650" as="geometry" />
        </mxCell>
        <mxCell id="ld-run" parent="1" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;fontStyle=1;align=center" value="PTRACE_CONT → ld runs → exit(0)" vertex="1">
          <mxGeometry height="30" width="250" x="680" y="650" as="geometry" />
        </mxCell>
        <mxCell id="ld-h1" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=1" value="POST-EXEC: Hash output binary&#xa;SHA256(curl) → fff000.." vertex="1">
          <mxGeometry height="35" width="230" x="680" y="700" as="geometry" />
        </mxCell>
        <mxCell id="ld-h2" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=1;strokeWidth=2" value="bomsh_record_raw_info(cmd)&#xa;Write to raw_logfile" vertex="1">
          <mxGeometry height="35" width="230" x="680" y="755" as="geometry" />
        </mxCell>
        <mxCell id="ld-log" parent="1" style="rounded=1;fillColor=#f0f0f0;strokeColor=#999;fontSize=8;align=left;spacingLeft=8;verticalAlign=top" value="outfile: fff000.. path: curl&#xa;infile: 7a8b9c.. path: main.o&#xa;infile: ddd444.. path: libcurl.a&#xa;dynlib: ccc555.. path: /usr/lib/.../libssl.so&#xa;dynlib: eee777.. path: /usr/lib/.../libcrypto.so&#xa;dynlib: fff999.. path: /usr/lib/.../libz.so" vertex="1">
          <mxGeometry height="95" width="330" x="1050" y="670" as="geometry" />
        </mxCell>
        <mxCell id="ld-note" parent="1" style="shape=note;size=14;fillColor=#e0e0e0;strokeColor=#9e9e9e;fontSize=9;align=left;spacingLeft=5;verticalAlign=top;whiteSpace=wrap" value="KEY: infile vs dynlib in raw logfile&#xa;&#xa;infile: = Statically linked (code embedded in binary)&#xa;  → SPDX relationship: STATIC_LINK&#xa;&#xa;dynlib: = Dynamically linked (loaded at runtime)&#xa;  → SPDX relationship: DYNAMIC_LINK&#xa;&#xa;This distinction is captured at build-interception time&#xa;by examining -l flags vs bare .o/.a arguments." vertex="1">
          <mxGeometry height="150" width="300" x="1050" y="800" as="geometry" />
        </mxCell>
        <mxCell id="ld-a1" edge="1" parent="1" source="ld-cmd" target="ld-parse" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ld-a2" edge="1" parent="1" source="ld-parse" target="ld-resolve" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ld-a3" edge="1" parent="1" source="ld-resolve" target="ld-run" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ld-a4" edge="1" parent="1" source="ld-run" target="ld-h1" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ld-a5" edge="1" parent="1" source="ld-h1" target="ld-h2" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ld-a6" edge="1" parent="1" source="ld-h2" target="ld-log" style="strokeWidth=2;strokeColor=#333">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 - Raw Logfile to SPDX End-to-End" id="raw-to-spdx">
    <mxGraphModel dx="1422" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="e-title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=center" value="End-to-End: Raw Logfile to ADG/Treedb to SPDX 2.3 JSON" vertex="1">
          <mxGeometry height="40" width="800" x="400" y="20" as="geometry" />
        </mxCell>
        <!-- bomsh layer -->
        <mxCell id="rawlog" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=8;verticalAlign=top" value="bomsh_hook_raw_logfile (text)&#xa;&#xa;gcc record:&#xa;outfile: 7a8b.. path: main.o&#xa;infile: 1234.. path: main.c&#xa;infile: abcd.. path: curl.h&#xa;infile: fedc.. path: stdio.h&#xa;&#xa;ar record:&#xa;outfile: ddd4.. path: libcurl.a&#xa;infile: aaa1.. path: x509.o&#xa;infile: bbb2.. path: ssl.o&#xa;&#xa;ld record:&#xa;outfile: fff0.. path: curl&#xa;infile: 7a8b.. path: main.o&#xa;infile: ddd4.. path: libcurl.a&#xa;dynlib: ccc5.. path: libssl.so" vertex="1">
          <mxGeometry height="260" width="230" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="bom-py" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1" value="bomsh_create_bom.py&#xa;(bomsh/scripts/)&#xa;Parses raw logfile,&#xa;builds dependency graph" vertex="1">
          <mxGeometry height="65" width="200" x="370" y="160" as="geometry" />
        </mxCell>
        <mxCell id="treedb" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=8;verticalAlign=top" value="bomsh_omnibor_treedb (JSON)&#xa;&#xa;{ &quot;gitoid:sha256:1234..&quot;:&#xa;    { &quot;file_path&quot;: &quot;main.c&quot; },&#xa;  &quot;gitoid:sha256:7a8b..&quot;:&#xa;    { &quot;file_path&quot;: &quot;main.o&quot;,&#xa;      &quot;build_cmd&quot;: &quot;gcc -c..&quot; },&#xa;  ... }&#xa;&#xa;Maps: gitoid hash → file path" vertex="1">
          <mxGeometry height="150" width="220" x="370" y="290" as="geometry" />
        </mxCell>
        <mxCell id="adg" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=8;align=left;spacingLeft=8;verticalAlign=top" value="ADG (.omnibor/ directory)&#xa;&#xa;One file per output artifact:&#xa;gitoid_sha256_fff0..&#xa;  (for curl binary)&#xa;  blob gitoid:sha256:7a8b..&#xa;  blob gitoid:sha256:ddd4..&#xa;&#xa;Maps: output → all its inputs&#xa;(OmniBOR standard format)" vertex="1">
          <mxGeometry height="145" width="220" x="370" y="465" as="geometry" />
        </mxCell>
